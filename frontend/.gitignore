logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and builds
node_modules
dist
dist-ssr
build/
*.local

# ==========================
# 3. Project Specific (Crucial!)
# ==========================
